# ============================================================================
# JobInsight – variables d'environnement
# Copier ce fichier en .env puis remplacer TOUS les "change-me".
# Le fichier .env contient des secrets : il est exclu de Git (.gitignore).
# Générer un secret :  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Générer la clé Fernet Airflow :
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# ============================================================================

# --- Airflow ---
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_FERNET_KEY=change-me
AIRFLOW_SECRET_KEY=change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# --- MinIO (Data Lake) ---
MINIO_ROOT_USER=jobinsight-admin
MINIO_ROOT_PASSWORD=change-me-min-8-chars

# --- MongoDB ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me
MONGO_PIPELINE_USER=jobinsight_pipeline
MONGO_PIPELINE_PASSWORD=change-me
MONGO_API_USER=jobinsight_api
MONGO_API_PASSWORD=change-me
MONGO_BI_USER=jobinsight_bi
MONGO_BI_PASSWORD=change-me

# --- Backend / sécurité ---
JWT_SECRET=change-me-long-random-string
JWT_EXPIRE_MINUTES=120
ADMIN_EMAIL=admin@jobinsight.local
ADMIN_PASSWORD=change-me
PIPELINE_SERVICE_TOKEN=change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- IA ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Collecte ---
ARBEITNOW_MAX_PAGES=3
PYTHONORG_MAX_PAGES=3
# Sources optionnelles (laisser vide = source désactivée)
# Adzuna : clé gratuite sur https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# France Travail : application à créer sur https://francetravail.io (API "Offres d'emploi v2")
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
